{
  "name": "@preco-real/ui",
  "version": "0.1.0",
  "description": "Design System Preço Real: tokens, componentes React e catálogos de idioma (pt_pt, en).",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./i18n/pt_pt.json": "./dist/i18n/pt_pt.json",
    "./i18n/en.json": "./dist/i18n/en.json"
  },
  "files": [
    "dist",
    "README.md",
    "I18N.md"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "vite build && npm run tokens && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "build:ds": "node scripts/build-ds.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0"
  }
}
